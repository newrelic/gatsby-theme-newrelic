    "babel-jest": "^26.3.0",
    "babel-preset-gatsby": "^1.3.0",
    "eslint": "^7.4.0",
    "eslint-plugin-graphql": "^4.0.0",
    "eslint-plugin-jsx-a11y": "^6.6.0",
    "eslint-plugin-react-hooks": "^4.0.8",
    "jest": "^26.4.0",
